# Copy to .env and adjust. Never commit the real .env.
APP_NAME=Rika
APP_ENV=development
APP_DEBUG=true

APP_HOST=127.0.0.1
APP_PORT=8000

# --- PostgreSQL (docker compose) ---
# Keep POSTGRES_* in sync with DATABASE_URL below.
POSTGRES_USER=rika
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rika
DATABASE_URL=postgresql+asyncpg://rika:change-me@127.0.0.1:5432/rika

# --- Redis (docker compose) ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- Local model servers (llama.cpp llama-server) ---
CHAT_BASE_URL=http://127.0.0.1:8080
CHAT_MODEL_NAME=local-chat-model

EMBEDDING_BASE_URL=http://127.0.0.1:8081
EMBEDDING_MODEL_NAME=local-embedding-model
# Must equal the model's real output size. Verify with:
#   python -m app.cli check-models
EMBEDDING_DIMENSION=VERIFY_BEFORE_USE

# Seconds before a model-server call gives up.
MODEL_REQUEST_TIMEOUT=30
# Embedding batches are larger and run on the CPU, so they get more time.
EMBEDDING_TIMEOUT=120
# Seconds allowed per dependency in /health/ready.
READINESS_TIMEOUT=2

# --- Storage ---
STORAGE_ROOT=storage
MAX_UPLOAD_MB=100
MAX_ARCHIVE_FILES=5000
MAX_ARCHIVE_EXPANDED_MB=1000

# --- Ingestion ---
# Characters per chunk and the overlap between consecutive chunks. Chunks are
# cut on line boundaries so citations can name a line range.
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200
# Chunks sent to the embedding server per request.
EMBEDDING_BATCH_SIZE=16

# --- Frontend dev origins ---
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

LOG_LEVEL=INFO
